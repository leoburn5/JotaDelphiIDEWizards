package JotaIDEWizards;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Jota IDE Wizards - atalhos e experts personalizados para a IDE do Delphi'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  dbrtl,
  designide;

contains
  Jota.IDEWizards.OTAUtils in 'Source\Jota.IDEWizards.OTAUtils.pas',
  Jota.IDEWizards.SqlDelphiConverter in 'Source\Jota.IDEWizards.SqlDelphiConverter.pas',
  Jota.IDEWizards.Theming in 'Source\Jota.IDEWizards.Theming.pas',
  Jota.IDEWizards.Toast in 'Source\Jota.IDEWizards.Toast.pas',
  Jota.IDEWizards.SqlConvertChoiceDialog in 'Source\Jota.IDEWizards.SqlConvertChoiceDialog.pas',
  Jota.IDEWizards.KeyBindings in 'Source\Jota.IDEWizards.KeyBindings.pas',
  Jota.IDEWizards.SplashScreen in 'Source\Jota.IDEWizards.SplashScreen.pas',
  Jota.IDEWizards.NewFMTBCDFieldDialog in 'Source\Jota.IDEWizards.NewFMTBCDFieldDialog.pas',
  Jota.IDEWizards.UsesClause in 'Source\Jota.IDEWizards.UsesClause.pas',
  Jota.IDEWizards.FieldWizards in 'Source\Jota.IDEWizards.FieldWizards.pas',
  Jota.IDEWizards.JotaMenu in 'Source\Jota.IDEWizards.JotaMenu.pas',
  Jota.IDEWizards.Register in 'Source\Jota.IDEWizards.Register.pas';

end.
